#!/bin/sh
# コミット前に cargo fmt を実行し、整形した .rs ファイルをコミットに含める

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')
[ -z "$files" ] && exit 0

if ! cargo fmt --all; then
  echo "cargo fmt に失敗しました。コミットを中止します" >&2
  exit 1
fi

# 整形結果を、コミット対象だったファイルだけステージし直す
echo "$files" | while IFS= read -r f; do
  git add -- "$f"
done